---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="CV" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="cv-page">
      <h1>CV</h1>
      <p>You can view or download my latest CV below.</p>

      <p>
        <a class="cv-download" href="/cv/shan-islam-cv.pdf" download>Download CV</a>
      </p>

      <div class="cv-embed">
        <iframe src="/cv/shan-islam-cv.pdf" width="100%" height="900" title="Shan Islam CV">Your browser does not support embedded PDFs. You can <a href="/cv/shan-islam-cv.pdf">download the PDF</a>.</iframe>
      </div>

    </main>
    <Footer />
  </body>
</html>
