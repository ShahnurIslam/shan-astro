---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Shan Islam</h1>

			<p>
				I write about pricing, experimentation, forecasting and practical data science.
			</p>

			<p>
				Most of the writing here is about what I have learned from working on commercial data science problems:
				A/B testing, dynamic pricing, demand forecasting, messy data and stakeholder decision making.
			</p>

			<p>
				<a href="/blog/">Read the blog</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
