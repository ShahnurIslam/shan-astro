---
import BaseHead from '../components/BaseHead.astro';
import CommercialDataRescuePreview from '../components/CommercialDataRescuePreview.astro';
import ExperimentDecisionPreview from '../components/ExperimentDecisionPreview.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PricingForecastPreview from '../components/PricingForecastPreview.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import '../styles/prototypes.css';

function normalisePath(src) {
	if (!src || typeof src !== 'string') return '#';
	return src.startsWith('/') ? src : `/blog/${src.replace(/^\/+/, '')}`;
}

const allPosts = await getCollection('blog');
const latestPost = allPosts
	.filter((post) => !post.data?.draft)
	.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="prototype-body proto-editorial home-editorial" data-editorial-palette="blue">
		<main class="editorial-page">
			<header class="editorial-nav">
				<a class="editorial-brand" href="/">Shan Islam</a>
				<nav aria-label="Primary navigation">
					<a href="/work/">Work</a>
					<a href="/tools/experiment-decision-checker/">Tool</a>
					<a href="/blog/">Writing</a>
					<a href="/snippets/">Snippets</a>
					<a href="/cv/">CV</a>
				</nav>
			</header>

			<section class="editorial-hero" id="top">
				<div class="editorial-hero__copy">
					<p class="editorial-eyebrow">Lead Data Scientist · London</p>
					<h1>Better commercial decisions, built from evidence.</h1>
					<p class="editorial-deck">
						I specialise in pricing, forecasting and experimentation—building practical models and decision systems for the moments where clarity matters.
					</p>
					<div class="editorial-actions">
						<a class="editorial-button" href="/work/">Explore selected work</a>
						<a class="editorial-text-link" href="/cv/">View CV <span aria-hidden="true">↗</span></a>
					</div>
				</div>

				<aside class="editorial-practice" aria-label="Areas of practice">
					<p class="editorial-practice__label">Areas of practice</p>
					<ol>
						<li><span>01</span><strong>Pricing &amp; demand forecasting</strong></li>
						<li><span>02</span><strong>Experimentation &amp; causal inference</strong></li>
						<li><span>03</span><strong>Commercial decision systems</strong></li>
					</ol>
				</aside>
			</section>

			<div class="editorial-identity" aria-label="Identity and focus">
				<span>Bangladeshi heritage</span>
				<span>London perspective</span>
				<span>Decision science</span>
			</div>

			<section class="editorial-work" aria-labelledby="editorial-work-title">
				<header class="editorial-section-head">
					<p>Selected work</p>
					<h2 id="editorial-work-title">Work designed to change the next decision.</h2>
				</header>
				<div class="editorial-work-grid">
					<a class="editorial-case" href="/work/marketplace-pricing-demand-forecasting/">
						<span class="editorial-case__meta">Pricing &amp; forecasting · Case 01</span>
						<div class="editorial-case__preview"><PricingForecastPreview /></div>
						<h3>Marketplace pricing &amp; demand forecasting</h3>
						<p>Using demand and capacity forecasts to decide when—and how much—to intervene on price.</p>
						<span class="editorial-case__link">Read case study <span aria-hidden="true">→</span></span>
					</a>
					<a class="editorial-case" href="/work/experimentation-causal-decision-making/">
						<span class="editorial-case__meta">Experimentation · Case 02</span>
						<div class="editorial-case__preview"><ExperimentDecisionPreview /></div>
						<h3>Experimentation &amp; causal decision making</h3>
						<p>Designing experiments around commercial decisions, not statistical significance alone.</p>
						<span class="editorial-case__link">Read case study <span aria-hidden="true">→</span></span>
					</a>
					<a class="editorial-case" href="/work/commercial-data-rescue/">
						<span class="editorial-case__meta">Commercial analytics · Case 03</span>
						<div class="editorial-case__preview"><CommercialDataRescuePreview /></div>
						<h3>Commercial data rescue</h3>
						<p>Turning fragmented signals into a shared diagnostic path.</p>
						<span class="editorial-case__link">Read case study <span aria-hidden="true">→</span></span>
					</a>
				</div>
			</section>

			<section class="editorial-writing" aria-labelledby="editorial-writing-title">
				<div>
					<p class="editorial-writing__label">From the notebook</p>
					<h2 id="editorial-writing-title">Thinking in public.</h2>
				</div>
				{latestPost ? (
					<a href={normalisePath(latestPost.slug ?? latestPost.id ?? '')}>
						<span><FormattedDate date={latestPost.data.pubDate} /></span>
						<strong>{latestPost.data.title}</strong>
						<span aria-hidden="true">↗</span>
					</a>
				) : (
					<a href="/blog/">
						<span>Notebook</span>
						<strong>Read my writing</strong>
						<span aria-hidden="true">↗</span>
					</a>
				)}
			</section>

			<footer class="editorial-footer">
				<p>© 2026 Shan Islam · Lead Data Scientist</p>
				<p>Bangladeshi roots, building in London.</p>
			</footer>
		</main>
	</body>
</html>
