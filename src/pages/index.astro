---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { experimentSeries, seriesTitle } from '../data/experimentSeries';
import '../styles/home.css';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
const featured = posts.find((post) => post.id === 'a-b-testing-is-a-decision-problem');
const seriesDescriptions = [
  'False-positive risk, outcome maturity and commercial opportunity when an A/B test shows an early signal.',
  'How a fixed-power design adapts the sample requirement as mature outcomes reveal the actual variability.',
  'How a protected comparison can keep learning while a separate population receives a promising treatment.',
];
const latestSeries = experimentSeries.flatMap((item, index) => {
  const post = posts.find((candidate) => candidate.id === item.slug);
  return post ? [{ ...item, post, description: seriesDescriptions[index] }] : [];
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Shan Islam | Data science, experiments and decisions" description="Shan Islam explores commercial data science, experimentation and machine learning through practical work, tools and writing." />
  </head>
  <body>
    <Header />
    <main class="page-shell home-page">
      <section class="home-intro" aria-labelledby="home-title">
        <h1 id="home-title">Hi, I'm Shan.</h1>
        <p>I'm a data scientist who enjoys solving difficult problems, building useful things and exploring ideas. My work spans pricing, forecasting and experimentation, with a focus on making data useful in the real world.</p>
      </section>

      {featured && <section class="home-feature" aria-label="Featured article">
        <a class="home-feature__image" href={`/blog/${featured.id}/`} aria-label={`Read ${featured.data.title}`}>
          <img src="/images/ab-testing-decision-cover-v2.webp" alt="A traveller pauses where two paths diverge through green and terracotta hills" width="1280" height="656" />
        </a>
        <div class="home-feature__copy">
          <h2>{featured.data.title}</h2>
          <p>How much evidence do we need to make a decision, and what does it cost us to be wrong?</p>
          <a class="text-link" href={`/blog/${featured.id}/`}>Read the article <span aria-hidden="true">→</span></a>
        </div>
      </section>}

      <section class="home-latest" aria-labelledby="latest-title">
        <h2 id="latest-title">Latest writing</h2>
        <p class="home-series__label">{seriesTitle} <span aria-hidden="true">·</span> A three-part series</p>
        <ol class="editorial-list home-series__list" aria-label="Experimentation in the Real World articles">
          {latestSeries.map((item) => <li><a class="editorial-row" href={`/blog/${item.slug}/`}>
            <span class="home-series__title"><small>Part {item.part} of 3</small><strong>{item.title}</strong></span>
            <span>{item.description}</span>
            <span class="editorial-row__arrow" aria-hidden="true">→</span>
          </a></li>)}
        </ol>
        <a class="text-link home-writing-link" href="/blog/">View all writing <span aria-hidden="true">→</span></a>
      </section>
      <nav class="home-more" aria-label="Work and tools">
        <a class="text-link" href="/work/">Explore my work <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/tools/experiment-decision-checker/">See what I've built <span aria-hidden="true">→</span></a>
      </nav>
    </main>
    <Footer />
  </body>
</html>
