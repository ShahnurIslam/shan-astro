---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

function normalisePath(src) {
	if (!src || typeof src !== 'string') return null;
	return src.startsWith('/') ? src : `/blog/${src.replace(/^\/+/, '')}`;
}

function normaliseImage(src) {
	if (!src || typeof src !== 'string') return null;
	return src.startsWith('/') ? src : `/${src}`;
}

function excerptFor(post, length = 200) {
	const desc = post?.data?.description;
	if (desc && typeof desc === 'string') return desc;
	const body = typeof post.body === 'string' ? post.body : '';
	return body.length > length ? body.substring(0, length) + '...' : body;
}

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((p) => !p.data?.draft)
	.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-page">
			<section class="home-hero">
				<figure class="home-banner">
					<img src="/images/home-banner.png" alt="Site banner" />
				</figure>
				<div class="home-intro">
					<h1>Pricing, forecasting and better commercial decisions</h1>

					<p>
						I’m Shan, a Lead Data Scientist specialising in pricing, forecasting, experimentation and applied machine learning.
					</p>

					<p>
						I help businesses turn messy commercial and operational data into better decisions. I also write about what I have learned from doing that work in practice.
					</p>
				</div>
			</section>

			<section class="selected-work-preview" aria-labelledby="selected-work-heading">
				<p class="section-label">Commercial data science</p>
				<h2 id="selected-work-heading">Selected Work</h2>
				<p class="section-intro">
					I help businesses turn messy commercial and operational data into better decisions.
				</p>
				<div class="work-grid">
					<WorkCard
						title="Marketplace Pricing & Demand Forecasting"
						description="Turning noisy demand and capacity signals into actionable pricing decisions."
						capability="Pricing & forecasting"
						value="When and how much to intervene — and when to leave price alone."
						href="/work/marketplace-pricing-demand-forecasting/"
					/>
					<WorkCard
						title="Experimentation & Causal Decision Making"
						description="Designing experiments that answer commercial decisions rather than merely produce significant results."
						capability="Experimentation"
						value="Whether a commercial change should be rolled out."
						href="/work/experimentation-causal-decision-making/"
					/>
					<WorkCard
						title="Commercial Data Rescue"
						description="Turning fragmented operational signals into a decision tool that tells teams where to look first."
						capability="Commercial analytics"
						value="Find the cause of a performance change quickly."
						href="/work/commercial-data-rescue/"
					/>
				</div>
				<p class="section-link"><a href="/work/">Explore Selected Work</a></p>
			</section>

			<section class="latest-writing">
				<h2>Latest writing</h2>
				<div class="latest-list">
					{posts.length === 0 ? (
						<p>No posts yet.</p>
					) : (
						posts.map((post) => (
							<article class="post-card">
								<h3>
									{
										(() => {
											const href = normalisePath(post.slug ?? post.id ?? '');
											return (
												<a href={href ?? '#'}>
													{post.data.title}
												</a>
											);
										})()
									}
								</h3>
								<div class="post-meta">{new Date(post.data.pubDate).toLocaleDateString()}</div>
								<p class="post-excerpt">{excerptFor(post)}</p>
							</article>
						))
					)}
				</div>
				<p><a href="/blog/">See all posts</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
