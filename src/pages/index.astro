---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/home.css';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts.find((post) => post.id === 'a-b-testing-is-a-decision-problem');
const latest = posts.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Shan Islam | Data science, experiments and decisions" description="Shan Islam explores commercial data science, experimentation and machine learning through practical work, tools and writing." />
  </head>
  <body>
    <Header />
    <main class="page-shell home-page">
      <section class="home-intro" aria-labelledby="home-title">
        <h1 id="home-title">Hi, I’m Shan.</h1>
        <p>I’m a data scientist interested in how evidence becomes decisions.</p>
      </section>

      {featured && <section class="home-feature" aria-label="Featured article">
        <a class="home-feature__image" href={`/blog/${featured.id}/`} aria-label={`Read ${featured.data.title}`}>
          <img src="/images/ab-testing-decision-cover-v2.webp" alt="A traveller pauses where two paths diverge through green and terracotta hills" width="1280" height="656" />
        </a>
        <div class="home-feature__copy">
          <h2>{featured.data.title}</h2>
          <p>{featured.data.description}</p>
          <a class="text-link" href={`/blog/${featured.id}/`}>Read the article <span aria-hidden="true">→</span></a>
        </div>
      </section>}

      <section class="home-latest" aria-labelledby="latest-title">
        <h2 id="latest-title">Latest writing</h2>
        <div class="editorial-list">
          {latest.map((post) => <a class="editorial-row" href={`/blog/${post.id}/`}>
            <strong>{post.data.title}</strong>
            <span>{post.data.description}</span>
            <span class="editorial-row__arrow" aria-hidden="true">→</span>
          </a>)}
        </div>
        <p class="home-explore"><a class="text-link" href="/work/">Explore my work</a><span aria-hidden="true"> · </span><a class="text-link" href="/tools/experiment-decision-checker/">Try the tools <span aria-hidden="true">→</span></a></p>
      </section>
    </main>
    <Footer />
  </body>
</html>
