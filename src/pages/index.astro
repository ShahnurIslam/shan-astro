---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

function normalisePath(src) {
	if (!src || typeof src !== 'string') return null;
	return src.startsWith('/') ? src : `/blog/${src.replace(/^\/+/, '')}`;
}

function normaliseImage(src) {
	if (!src || typeof src !== 'string') return null;
	return src.startsWith('/') ? src : `/${src}`;
}

function excerptFor(post, length = 200) {
	const desc = post?.data?.description;
	if (desc && typeof desc === 'string') return desc;
	const body = typeof post.body === 'string' ? post.body : '';
	return body.length > length ? body.substring(0, length) + '...' : body;
}

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((p) => !p.data?.draft)
	.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-page">
			<section class="home-hero">
				<figure class="home-banner">
					<img src="/images/home-banner.png" alt="" />
				</figure>
				<div class="home-intro">
					<h1>Shan Islam</h1>
					<p class="home-tagline">Data science for better commercial decisions</p>
					<p class="home-summary">
						I’m a Lead Data Scientist specialising in pricing, forecasting and experimentation. I build practical models and decision systems, and write about what I learn from doing the work.
					</p>
					<div class="home-actions" aria-label="Explore the site">
						<a href="/work/">View selected work <span aria-hidden="true">→</span></a>
						<a href="/blog/">Read my writing <span aria-hidden="true">→</span></a>
					</div>
				</div>
			</section>

			<section class="selected-work-preview" aria-labelledby="selected-work-heading">
				<h2 id="selected-work-heading">Selected Work</h2>
				<div class="home-work-grid">
					<article class="home-work-entry">
						<h3><a href="/work/marketplace-pricing-demand-forecasting/">Marketplace pricing &amp; demand forecasting</a></h3>
						<p>Using demand and capacity forecasts to decide when and how much to intervene on price.</p>
					</article>
					<article class="home-work-entry">
						<h3><a href="/work/experimentation-causal-decision-making/">Experimentation &amp; causal decision making</a></h3>
						<p>Designing experiments around the commercial decision, not just statistical significance.</p>
					</article>
					<article class="home-work-entry">
						<h3><a href="/work/commercial-data-rescue/">Commercial data rescue</a></h3>
						<p>Turning fragmented trading signals into a shared diagnostic path.</p>
					</article>
				</div>
				<p class="section-link"><a href="/work/">View all selected work <span aria-hidden="true">→</span></a></p>
			</section>

			<section class="home-writing" aria-labelledby="writing-heading">
				<h2 id="writing-heading">Writing</h2>
				<div class="home-writing-list">
					{posts.length === 0 ? (
						<p>No posts yet.</p>
					) : (
						posts.map((post) => (
							<article class="home-writing-entry">
								<p class="home-writing-entry__date"><FormattedDate date={post.data.pubDate} /></p>
								<div>
									<h3>
										<a href={normalisePath(post.slug ?? post.id ?? '') ?? '#'}>{post.data.title}</a>
									</h3>
									<p>{excerptFor(post, 170)}</p>
								</div>
							</article>
						))
					)}
				</div>
				<p class="section-link"><a href="/blog/">Read all writing <span aria-hidden="true">→</span></a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
