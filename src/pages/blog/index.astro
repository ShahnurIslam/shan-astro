---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data?.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function stripBasicMarkdown(text) {
	if (!text || typeof text !== 'string') return '';
	let s = text;
	// Remove images
	s = s.replace(/!\[[^\]]*\]\([^)]*\)/g, '');
	// Replace links with link text
	s = s.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1');
	// Remove headings
	s = s.replace(/^#{1,6}\s*/gm, '');
	// Remove blockquotes
	s = s.replace(/^>\s?/gm, '');
	// Remove code fences and inline code
	s = s.replace(/```[\s\S]*?```/g, '');
	s = s.replace(/`([^`]*)`/g, '$1');
	// Remove list markers
	s = s.replace(/^[\s]*[-*+]\s+/gm, '');
	s = s.replace(/^[0-9]+\.\s+/gm, '');
	// Collapse whitespace
	s = s.replace(/\s+/g, ' ').trim();
	return s;
}

function excerptFromPost(post, len = 180) {
	const desc = post?.data?.description;
	if (desc && typeof desc === 'string') return desc.length > len ? desc.slice(0, len) + '...' : desc;
	const body = typeof post.body === 'string' ? stripBasicMarkdown(post.body) : '';
	if (!body) return '';
	return body.length > len ? body.slice(0, len) + '...' : body;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing | ${SITE_TITLE}`} description="Writing about pricing, experimentation, forecasting and practical data science." />
	</head>
	<body>
		<Header />
		<main class="blog-page">
			<section class="blog-intro">
				<p class="section-label">Writing &amp; field notes</p>
				<h1>Ideas, evidence and decisions.</h1>
				<p>I write about pricing, experimentation, forecasting and the practical judgement behind useful data science.</p>
				<p class="blog-intro__count">{posts.length} published notes</p>
			</section>
			<section class="blog-list">
				{
					posts.length === 0 ? (<p>No posts yet.</p>) : (
						posts.map((post, index) => (
							<a class="blog-entry" href={`/blog/${post.id}/`}>
								<span class="blog-entry__number">{String(index + 1).padStart(2, '0')}</span>
								<div class="blog-entry__title">
									<p>
										<FormattedDate date={post.data.pubDate} />
										{post.data.tags.length > 0 && <span> · {post.data.tags.slice(0, 2).join(' · ')}</span>}
									</p>
									<h2>{post.data.title}</h2>
								</div>
								<p class="blog-entry__excerpt">{excerptFromPost(post)}</p>
								<span class="blog-entry__arrow" aria-hidden="true">↗</span>
							</a>
						))
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
