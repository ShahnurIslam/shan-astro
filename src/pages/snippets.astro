---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { Code } from 'astro:components';
import { snippets, dateFormats } from '../data/snippets';

const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const categories = [...new Set(snippets.map((snippet) => snippet.category))].map((name) => {
  const items = snippets.filter((snippet) => snippet.category === name);
  const topics = [...new Set(items.map((snippet) => snippet.topic))].map((topic) => ({
    name: topic,
    id: `${slug(name)}-${slug(topic)}`,
    items: items.filter((snippet) => snippet.topic === topic),
  }));
  return { name, id: slug(name), items, topics };
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Code snippets | Shan Islam" description="A searchable notebook of reusable code snippets for Python, pandas, charts, experiments, SQL and cloud tools." />
  </head>
  <body>
    <Header />
    <main class="snippets-page">
      <header class="snippets-intro">
        <h1>Code snippets</h1>
        <p>Reusable examples for data, analysis and development.</p>
        <label class="snippet-search-label" for="snippet-search">Search snippets</label>
        <input id="snippet-search" class="snippet-search" type="search" placeholder="Search snippets…" autocomplete="off" />
        <p id="snippet-results" class="snippet-results" aria-live="polite">{snippets.length} snippets</p>
      </header>

      <div class="snippets-layout">
        <details class="snippets-topics" open>
        <summary>Browse topics</summary>
        <nav class="snippets-toc" aria-label="Snippet topics">
          <strong>Browse snippets</strong>
          <ul>
            {categories.map((category) => (
              <li>
                <a href={`#${category.id}`}>{category.name}</a>
                <ul>{category.topics.map((topic) => <li><a href={`#${topic.id}`}>{topic.name}</a></li>)}</ul>
              </li>
            ))}
          </ul>
        </nav>
        </details>

        <div class="snippets-content">
          {categories.map((category) => (
            <section id={category.id} class="snippet-section" data-snippet-section>
              <header class="snippet-section__header">
                <h2>{category.name}</h2>
                <span>{category.items.length} snippets</span>
              </header>
              {category.topics.map((topic) => (
                <section id={topic.id} class="snippet-subsection" data-snippet-topic>
                  <h3>{topic.name} <span>{topic.items.length}</span></h3>
                  {category.name === 'pandas' && topic.name === 'Dates & time' && (
                    <div class="date-reference">
                      <h4>Datetime format reference</h4>
                      <p>Use these tokens in <code>pd.to_datetime(series, format='…')</code>. For example, <code>14/10/2026 09:30</code> is <code>%d/%m/%Y %H:%M</code>. Capital letters matter: <code>%m</code> is month; <code>%M</code> is minute.</p>
                      <div class="date-reference__scroll">
                        <table>
                          <thead><tr><th scope="col">Token</th><th scope="col">Meaning</th><th scope="col">Example</th></tr></thead>
                          <tbody>{dateFormats.map(([token, meaning, example]) => <tr><th scope="row"><code>{token}</code></th><td>{meaning}</td><td>{example}</td></tr>)}</tbody>
                        </table>
                      </div>
                    </div>
                  )}
                  <div class="snippet-stack">
                    {topic.items.map((snippet) => (
                      <article class="snippet-card" data-snippet-card data-search={`${category.name} ${topic.name} ${snippet.title} ${snippet.description ?? ''} ${snippet.code}`.toLowerCase()}>
                        <header>
                          <h4>{snippet.title}</h4>
                          <button type="button" data-copy-snippet aria-label={`Copy ${snippet.title} code`}>Copy</button>
                        </header>
                        {snippet.description && <p class="snippet-description">{snippet.description}</p>}
                        <Code code={snippet.code} lang={snippet.language} theme="github-light" />
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </section>
          ))}
        </div>
      </div>
    </main>
    <Footer />
    <script is:inline>
      const topicMenu = document.querySelector('.snippets-topics');
      if (topicMenu && matchMedia('(max-width: 820px)').matches) topicMenu.open = false;
      topicMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        if (matchMedia('(max-width: 820px)').matches) topicMenu.open = false;
      }));
      const search = document.querySelector('#snippet-search');
      const results = document.querySelector('#snippet-results');
      const cards = [...document.querySelectorAll('[data-snippet-card]')];
      search?.addEventListener('input', () => {
        const terms = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        let visible = 0;
        cards.forEach((card) => {
          const matches = terms.every((term) => card.dataset.search.includes(term));
          card.hidden = !matches;
          if (matches) visible += 1;
        });
        document.querySelectorAll('[data-snippet-topic], [data-snippet-section]').forEach((section) => {
          section.hidden = !section.querySelector('[data-snippet-card]:not([hidden])');
        });
        results.textContent = `${visible} snippet${visible === 1 ? '' : 's'} found`;
      });

      document.addEventListener('click', async (event) => {
        const button = event.target.closest('[data-copy-snippet]');
        if (!button) return;
        const code = button.closest('.snippet-card')?.querySelector('pre code')?.textContent;
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          button.textContent = 'Copied';
          setTimeout(() => { button.textContent = 'Copy'; }, 1400);
        } catch {
          button.textContent = 'Select code';
        }
      });
    </script>
  </body>
</html>
