---
import BaseHead from '../../components/BaseHead.astro';
import CommercialDataRescuePreview from '../../components/CommercialDataRescuePreview.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ExperimentDecisionPreview from '../../components/ExperimentDecisionPreview.astro';
import PricingForecastPreview from '../../components/PricingForecastPreview.astro';
import WorkCard from '../../components/WorkCard.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Selected Work | Shan Islam"
			description="Selected data science work in pricing, forecasting, experimentation and commercial decision support."
		/>
	</head>
	<body>
		<Header />
		<main class="work-page">
			<header class="work-intro">
				<p class="section-label">Case studies · Lead Data Scientist</p>
				<h1>Work designed to change the next decision.</h1>
				<p class="work-intro__lead">
					I help businesses turn messy commercial and operational data into better decisions.
				</p>
				<p>
					I work on problems where better forecasting, experimentation or modelling can make the next action clearer.
				</p>
			</header>

			<section aria-labelledby="work-cases">
				<h2 id="work-cases" class="sr-only">Case studies</h2>
				<div class="work-grid">
					<WorkCard
						number="01"
						title="Marketplace Pricing & Demand Forecasting"
						description="Turning noisy demand and capacity signals into actionable pricing decisions."
						capability="Pricing & forecasting"
						value="When and how much to intervene — and when to leave price alone."
						href="/work/marketplace-pricing-demand-forecasting/"
					>
						<PricingForecastPreview slot="preview" />
					</WorkCard>
					<WorkCard
						number="02"
						title="Experimentation & Causal Decision Making"
						description="Designing experiments that answer commercial decisions, not merely produce statistically significant results."
						capability="Experimentation"
						value="Whether a commercial change should be rolled out, and what risk that decision accepts."
						href="/work/experimentation-causal-decision-making/"
					>
						<ExperimentDecisionPreview slot="preview" />
					</WorkCard>
					<WorkCard
						number="03"
						title="Commercial Data Rescue"
						description="Turning fragmented operational signals into a decision tool that tells teams where to look first."
						capability="Commercial analytics"
						value="Find the likely cause of a performance change quickly and focus investigation."
						href="/work/commercial-data-rescue/"
					>
						<CommercialDataRescuePreview slot="preview" />
					</WorkCard>
				</div>
			</section>

			<p class="work-disclosure">
				Case studies use anonymised descriptions and illustrative data. No confidential or proprietary employer/client data is shown.
			</p>
		</main>
		<Footer />
	</body>
</html>
