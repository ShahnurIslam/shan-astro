---
interface Props {
	title: string;
	description: string;
	capability: string;
	value: string;
	href: string;
}

const { title, description, capability, value, href } = Astro.props;
---

<article class="work-card">
	<p class="work-card__capability">{capability}</p>
	<h3><a href={href}>{title}</a></h3>
	<p class="work-card__description">{description}</p>
	<p class="work-card__value"><strong>Decision:</strong> {value}</p>
	<a class="work-card__link" href={href} aria-label={`View case study: ${title}`}>
		View case study <span aria-hidden="true">→</span>
	</a>
</article>

<style>
	.work-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 1.5rem;
		border: 1px solid var(--site-border);
		border-radius: 14px;
		background: var(--site-surface);
	}
	.work-card__capability {
		margin: 0 0 0.7rem;
		color: var(--site-accent);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.35;
		text-transform: uppercase;
	}
	h3 {
		font-size: clamp(1.35rem, 2.6vw, 1.75rem);
		line-height: 1.15;
		letter-spacing: -0.025em;
		margin-bottom: 0.8rem;
	}
	h3 a {
		color: var(--site-text);
		text-decoration: none;
	}
	h3 a:hover,
	h3 a:focus-visible {
		color: var(--site-accent);
	}
	.work-card__description,
	.work-card__value {
		font-size: 0.98rem;
		line-height: 1.6;
	}
	.work-card__description {
		color: var(--site-muted);
		margin: 0 0 1rem;
	}
	.work-card__value {
		margin: 0 0 1.2rem;
	}
	.work-card__link {
		align-self: flex-start;
		margin-top: auto;
		font-size: 0.95rem;
		font-weight: 700;
		text-underline-offset: 0.2em;
	}
</style>
