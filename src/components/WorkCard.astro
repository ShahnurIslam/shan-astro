---
interface Props {
	number: string;
	title: string;
	description: string;
	capability: string;
	value: string;
	href: string;
}

const { title, description, value, href } = Astro.props;
const hasPreview = Astro.slots.has('preview');
---

<article class:list={['work-card', { 'work-card--with-preview': hasPreview }]}>
	<div class="work-card__content">
		<div class="work-card__copy">
			<h3><a href={href}>{title}</a></h3>
			<p class="work-card__description">{description}</p>
			<p class="work-card__value"><strong>Decision:</strong> {value}</p>
			<a class="work-card__link text-link" href={href} aria-label={`View case study: ${title}`}>
				View case study <span aria-hidden="true">→</span>
			</a>
		</div>
		{hasPreview && <div class="work-card__preview"><slot name="preview" /></div>}
	</div>
</article>

<style>
	.work-card { padding: 16px 0; border-bottom: 1px solid var(--site-border); }
	.work-card__content { display: grid; grid-template-columns: minmax(0, .94fr) minmax(0, 1.06fr); gap: 32px; align-items: center; }
	.work-card__copy { min-width: 0; }
	h3 { max-width: 20ch; margin: 0 0 8px; font-size: clamp(23px, 2.2vw, 28px); line-height: 1.16; }
	h3 a { color: var(--site-text); text-decoration: none; }
	h3 a:hover { color: var(--site-green); }
	.work-card__description, .work-card__value { margin: 0 0 8px; font-size: 16px; line-height: 1.5; }
	.work-card__value strong { color: var(--site-green); }
	.work-card__preview { min-width: 0; }
	.work-card__link { display: inline-flex; gap: 6px; font-weight: 650; text-underline-offset: 5px; }
	@media (max-width: 820px) { .work-card__content { grid-template-columns: 1fr; gap: 16px; } }
</style>
