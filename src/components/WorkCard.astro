---
interface Props {
	number: string;
	title: string;
	description: string;
	capability: string;
	value: string;
	href: string;
}

const { number, title, description, capability, value, href } = Astro.props;
const hasPreview = Astro.slots.has('preview');
---

<article class:list={['work-card', { 'work-card--with-preview': hasPreview }]}>
	<div class="work-card__topline">
		<span>{number}</span>
		<p class="work-card__capability">{capability}</p>
	</div>
	<div class="work-card__content">
		<div class="work-card__copy">
			<h3><a href={href}>{title}</a></h3>
			<p class="work-card__description">{description}</p>
			<p class="work-card__value"><strong>Decision:</strong> {value}</p>
		</div>
		{hasPreview && <div class="work-card__preview"><slot name="preview" /></div>}
	</div>
	<a class="work-card__link" href={href} aria-label={`View case study: ${title}`}>
		View case study <span aria-hidden="true">→</span>
	</a>
</article>

<style>
	.work-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 300px;
		padding: 2rem;
		border: 1px solid var(--site-border);
		border-radius: 0;
		background: rgba(255,255,255,.28);
	}
	.work-card--with-preview {
		grid-column: 1 / -1;
		padding: clamp(2rem, 4vw, 4rem);
	}
	.work-card__topline {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--site-accent);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}
	.work-card__topline > span {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}
	.work-card__capability { margin: 0; }
	.work-card__content {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.work-card--with-preview .work-card__content {
		margin: clamp(2.5rem, 5vw, 4.5rem) 0 2rem;
		display: grid;
		grid-template-columns: minmax(0, .85fr) minmax(380px, 1.15fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: end;
	}
	h3 {
		margin: auto 0 1rem;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.8rem, 3vw, 3.1rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.04em;
	}
	h3 a { color: inherit; text-decoration: none; }
	h3 a:hover,
	h3 a:focus-visible { color: var(--site-accent); }
	.work-card__description,
	.work-card__value { font-size: 0.92rem; line-height: 1.6; }
	.work-card__description {
		color: var(--site-muted);
		margin: 0 0 1rem;
	}
	.work-card__value { margin: 0 0 1.2rem; }
	.work-card__preview { min-width: 0; }
	.work-card__link {
		align-self: flex-start;
		margin-top: auto;
		font-size: 0.95rem;
		font-weight: 700;
		text-underline-offset: 0.2em;
	}
	@media (max-width: 820px) {
		.work-card { min-height: 0; }
		.work-card--with-preview { grid-column: auto; }
		.work-card--with-preview .work-card__content {
			margin: 2.5rem 0 1.5rem;
			display: flex;
			gap: 1.5rem;
			align-items: stretch;
		}
		.work-card--with-preview h3 { margin-top: 0; }
	}
	@media (max-width: 520px) {
		.work-card { padding: 1.5rem; }
	}
</style>
