---
interface Props {
	number: string;
	featured?: boolean;
	title: string;
	description: string;
	capability: string;
	value: string;
	href: string;
}

const { number, featured = false, title, description, capability, value, href } = Astro.props;
---

<article class:list={['work-card', { 'work-card--featured': featured }]}>
	<div class="work-card__topline">
		<span>{number}</span>
		<p class="work-card__capability">{capability}</p>
	</div>
	<h3><a href={href}>{title}</a></h3>
	<p class="work-card__description">{description}</p>
	<p class="work-card__value"><strong>Decision:</strong> {value}</p>
	<a class="work-card__link" href={href} aria-label={`View case study: ${title}`}>
		View case study <span aria-hidden="true">→</span>
	</a>
</article>

<style>
	.work-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 300px;
		padding: 2rem;
		border: 1px solid var(--site-border);
		border-radius: 0;
		background: rgba(255,255,255,.28);
	}
	.work-card--featured {
		min-height: 618px;
		grid-row: span 2;
		padding: clamp(2rem, 4vw, 4rem);
		background: var(--site-blue);
		color: #f7fafb;
	}
	.work-card__topline {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--site-accent);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}
	.work-card__topline > span {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}
	.work-card--featured .work-card__topline {
		color: #d9c0a8;
	}
	.work-card__capability {
		margin: 0;
	}
	h3 {
		margin: auto 0 1rem;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.8rem, 3vw, 3.1rem);
		font-weight: 400;
		line-height: 1.02;
		letter-spacing: -0.04em;
	}
	h3 a {
		color: inherit;
		text-decoration: none;
	}
	h3 a:hover,
	h3 a:focus-visible {
		color: var(--site-accent);
	}
	.work-card__description,
	.work-card__value {
		font-size: 0.92rem;
		line-height: 1.6;
	}
	.work-card__description {
		color: var(--site-muted);
		margin: 0 0 1rem;
	}
	.work-card__value {
		margin: 0 0 1.2rem;
	}
	.work-card--featured .work-card__description,
	.work-card--featured .work-card__value {
		color: rgba(247,250,251,.74);
	}
	.work-card--featured h3,
	.work-card--featured h3 a {
		color: #fff;
	}
	.work-card__link {
		align-self: flex-start;
		margin-top: auto;
		font-size: 0.95rem;
		font-weight: 700;
		text-underline-offset: 0.2em;
	}
	.work-card--featured .work-card__link {
		color: #fff;
	}
	@media (max-width: 820px) {
		.work-card--featured {
			min-height: 430px;
			grid-row: auto;
		}
	}
</style>
