---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="nav-inner">
		<h2>
			<a href="/">
				<img src="/images/site-mark.png" alt="Shan Islam logo" class="site-mark" />
				<span class="site-title">{SITE_TITLE}</span>
			</a>
		</h2>
			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/snippets">Snippets</HeaderLink>
				<HeaderLink href="/cv">CV</HeaderLink>
			</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: transparent;
			border-bottom: 1px solid var(--site-border);
	}
		.nav-inner {
			max-width: 1100px;
			margin: 0 auto;
			padding: 0 1.25rem;
			display: flex;
			align-items: center;
			justify-content: space-between;
			min-height: 72px;
		}
		h2 {
			margin: 0;
			font-size: 1em;
		}

	.site-mark { width: 42px; height: 42px; border-radius: 999px; vertical-align: middle; margin-right: 0.6rem; object-fit: cover; }
	.site-title { vertical-align: middle; font-size: 1.05rem; font-weight: 700; }

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--site-text);
	}
	.internal-links {
		display: flex;
		gap: 1.5rem;
	}
	nav a {
		padding: 0.6rem 0.5rem;
		color: var(--site-text);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 1.05rem;
		font-weight: 500;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--site-accent);
		font-weight: 700;
	}
	@media (max-width: 720px) {
		.nav-inner {
			padding: 0 1rem;
		}
		.internal-links {
			gap: 0.5rem;
		}
	}
</style>
