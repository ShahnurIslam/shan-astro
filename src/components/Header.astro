---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const isToolPage = Astro.url.pathname.startsWith(
	'/tools/experiment-decision-checker',
);
---

<header>
	<nav class="nav-inner">
		<a class="site-title" href="/">{SITE_TITLE}</a>
			<div class="internal-links">
				<HeaderLink href="/work">Work</HeaderLink>
				<HeaderLink
					href="/tools/experiment-decision-checker/"
					class={isToolPage ? 'active' : undefined}
				>
					Tool
				</HeaderLink>
				<HeaderLink href="/blog">Writing</HeaderLink>
				<HeaderLink href="/snippets">Snippets</HeaderLink>
				<HeaderLink href="/cv">CV</HeaderLink>
			</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: transparent;
	}
	header::after {
		content: '';
		display: block;
		width: min(1320px, calc(100% - 56px));
		margin: 0 auto;
		border-bottom: 1px solid var(--site-border);
	}
		.nav-inner {
			width: min(1320px, calc(100% - 56px));
			margin: 0 auto;
			display: flex;
			align-items: center;
			justify-content: space-between;
			min-height: 94px;
		}

	.site-title {
		color: var(--site-text);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.4rem;
		text-decoration: none;
	}
	.site-title:hover,
	.site-title:focus-visible {
		text-decoration: none;
		color: var(--site-blue);
	}
	.internal-links {
		display: flex;
		gap: 2.2rem;
	}
	nav a {
		padding: 0.6rem 0;
		color: var(--site-text);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--site-accent);
	}
	@media (max-width: 720px) {
		header::after,
		.nav-inner {
			width: min(100% - 28px, 1320px);
		}
		.nav-inner {
			min-height: 82px;
		}
		.internal-links {
			gap: 0.75rem;
		}
		nav a {
			font-size: 0.72rem;
		}
	}
</style>
