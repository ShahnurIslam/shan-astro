---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	dek: string;
	capabilities: string[];
}

const { title, description, dek, capabilities } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Selected Work | Shan Islam`} description={description} />
	</head>
	<body>
		<Header />
		<main class="case-study">
			<nav class="case-study__breadcrumb" aria-label="Breadcrumb">
				<a href="/work/">Selected Work</a><span aria-hidden="true">/</span><span>{title}</span>
			</nav>

			<header class="case-study__header">
				<p class="case-study__eyebrow">Case study</p>
				<h1>{title}</h1>
				<p class="case-study__dek">{dek}</p>
				<ul class="capability-list" aria-label="Capabilities">
					{capabilities.map((capability) => <li>{capability}</li>)}
				</ul>
			</header>

			<article class="case-study__content">
				<slot />
			</article>

			<aside class="case-study__cta" aria-labelledby="case-study-contact">
				<div>
					<p class="case-study__eyebrow">Let’s solve the decision</p>
					<h2 id="case-study-contact">Need help with a pricing, forecasting or experimentation problem?</h2>
				</div>
				<div class="case-study__cta-links">
					<a href="mailto:shahnurislam@protonmail.com">Email Shan</a>
					<a href="https://linkedin.com/in/shanislam/" rel="me">LinkedIn</a>
				</div>
			</aside>
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	.case-study {
		width: min(1320px, calc(100% - 56px));
		margin: 0 auto;
		padding: 2rem 0 4rem;
	}
	.case-study__breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 3.25rem;
		color: var(--site-muted);
		font-size: 0.82rem;
		line-height: 1.4;
	}
	.case-study__breadcrumb a {
		font-weight: 700;
		text-underline-offset: 0.2em;
	}
	.case-study__breadcrumb span:last-child {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.case-study__header {
		max-width: 1080px;
		margin: clamp(4rem, 8vw, 8rem) 0 5rem;
	}
	.case-study__eyebrow {
		margin: 0 0 0.75rem;
		color: var(--site-accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		line-height: 1.35;
		text-transform: uppercase;
	}
	.case-study h1 {
		max-width: 1050px;
		color: var(--site-blue);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(3.8rem, 8vw, 7.8rem);
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: -0.06em;
		text-wrap: balance;
	}
	.case-study__dek {
		max-width: 780px;
		margin: 1.35rem 0 1.5rem;
		color: var(--site-muted);
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		line-height: 1.55;
	}
	.capability-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}
	.capability-list li {
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--site-border);
		border-radius: 0;
		background: transparent;
		color: var(--site-green);
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1.35;
	}
	.case-study__content {
		max-width: 840px;
		margin-left: clamp(0px, 12vw, 190px);
	}
	.case-study__content > section {
		margin: 0 0 3.75rem;
	}
	.case-study__content h2 {
		max-width: 700px;
		margin-bottom: 1rem;
		color: var(--site-blue);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.12;
		text-wrap: balance;
	}
	.case-study__content p,
	.case-study__content li {
		max-width: 720px;
		font-size: 1rem;
		line-height: 1.75;
	}
	.case-study__content p {
		margin: 0 0 1rem;
	}
	.case-study__content ul {
		padding-left: 1.2rem;
	}
	.decision-flow {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.55rem;
		padding: 0;
		margin: 1.5rem 0 0;
		list-style: none;
		counter-reset: step;
	}
	.decision-flow li {
		position: relative;
		padding: 1rem 0.85rem;
		border-top: 3px solid var(--site-blue);
		background: rgba(255,255,255,.34);
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.35;
		counter-increment: step;
	}
	.decision-flow li::before {
		content: "0" counter(step);
		display: block;
		margin-bottom: 0.3rem;
		color: var(--site-muted);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
	}
	.outcome-panel {
		padding: 1.4rem 1.5rem;
		border-left: 4px solid var(--site-accent);
		background: var(--site-surface);
	}
	.outcome-panel p:last-child {
		margin-bottom: 0;
	}
	.executive-visual {
		margin: 1.75rem 0 0;
		padding: clamp(1rem, 3vw, 1.5rem);
		border: 1px solid var(--site-border);
		border-radius: 0;
		background: var(--site-surface);
	}
	.executive-visual__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.executive-visual__header h3 {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.3;
	}
	.illustrative-label {
		flex: 0 0 auto;
		padding: 0.25rem 0.5rem;
		border: 1px solid var(--site-sand);
		border-radius: 999px;
		color: var(--site-muted);
		font-size: 0.7rem;
		font-weight: 700;
		line-height: 1.3;
		text-transform: uppercase;
	}
	.executive-visual svg {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
	}
	.chart-key {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin-bottom: 0.45rem;
		color: var(--site-text);
		font-size: 0.76rem;
		font-weight: 700;
		line-height: 1.35;
	}
	.chart-key span {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.chart-key__line {
		display: inline-block;
		width: 1.5rem;
		border-top: 3px solid;
	}
	.chart-key__line--demand {
		border-color: var(--site-accent);
	}
	.chart-key__line--capacity {
		border-color: var(--site-green);
	}
	.chart-key__line--forecast {
		border-color: var(--site-accent);
		border-top-style: dashed;
	}
	.executive-visual figcaption {
		max-width: 720px;
		margin-top: 0.85rem;
		color: var(--site-muted);
		font-size: 0.78rem;
		line-height: 1.5;
	}
	.case-study__cta {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
		margin: 6rem 0 0;
		padding: 2rem 0;
		border-top: 1px solid var(--site-border);
		border-bottom: 1px solid var(--site-border);
	}
	.case-study__cta h2 {
		max-width: 620px;
		margin: 0;
		color: var(--site-blue);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: clamp(1.8rem, 3vw, 2.6rem);
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.025em;
	}
	.case-study__cta-links {
		display: flex;
		flex: 0 0 auto;
		gap: 1rem;
	}
	.case-study__cta-links a {
		font-size: 0.95rem;
		font-weight: 700;
		text-underline-offset: 0.2em;
	}
	@media (max-width: 720px) {
		.case-study {
			width: min(100% - 28px, 1320px);
			padding: 1.5rem 0 2.5rem;
		}
		.case-study__breadcrumb {
			margin-bottom: 2.25rem;
		}
		.case-study__breadcrumb span:last-child {
			display: none;
		}
		.case-study__breadcrumb span[aria-hidden="true"] {
			display: none;
		}
		.case-study__header {
			margin: 3.5rem 0 3rem;
		}
		.case-study h1 {
			font-size: clamp(3.1rem, 15vw, 5rem);
		}
		.case-study__content > section {
			margin-bottom: 3rem;
		}
		.case-study__content {
			margin-left: 0;
		}
		.decision-flow {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.executive-visual {
			margin-inline: 0;
		}
		.executive-visual__header,
		.case-study__cta {
			align-items: flex-start;
			flex-direction: column;
		}
		.chart-key {
			gap: 0.45rem 0.9rem;
			font-size: 0.72rem;
		}
		.pricing-chart text {
			font-size: 20px;
		}
		.pricing-chart .pricing-chart__axis text {
			font-size: 18px;
		}
		.case-study__cta {
			gap: 1.25rem;
			margin-top: 3.5rem;
		}
	}
	@media (max-width: 420px) {
		.decision-flow {
			grid-template-columns: 1fr;
		}
		.executive-visual__header {
			gap: 0.6rem;
		}
	}
</style>
