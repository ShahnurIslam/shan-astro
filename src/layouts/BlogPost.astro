---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { experimentSeries, seriesTitle } from '../data/experimentSeries';

type Props = CollectionEntry<'blog'>['data'] & { headings?: { depth: number; slug: string; text: string }[] };
const { title, description, pubDate, updatedDate, heroImage, seriesPart, headings = [] } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
const current = seriesPart ? experimentSeries[seriesPart - 1] : undefined;
const previous = seriesPart && seriesPart > 1 ? experimentSeries[seriesPart - 2] : undefined;
const next = seriesPart && seriesPart < 3 ? experimentSeries[seriesPart] : undefined;
---

<!doctype html>
<html lang="en">
  <head><BaseHead title={`${title} | Shan Islam`} description={description} /></head>
  <body>
    <Header />
    <main class="article-page">
      <div class="article-layout">
        <article class:list={{ 'article--series': current }} data-series-part={seriesPart}>
          <header class="article-header">
            <a class="text-link article-back" href="/blog/">← All writing</a>
            {current && <p class="article-series-label">{seriesTitle} <span aria-hidden="true">·</span> Part {seriesPart} of 3</p>}
            <h1>{title}</h1>
            <p class="article-header__description">{description}</p>
            <div class="article-header__meta">Shan Islam <span aria-hidden="true">·</span> <FormattedDate date={pubDate} />{updatedDate && <> <span aria-hidden="true">·</span> Updated <FormattedDate date={updatedDate} /></>}</div>
          </header>
          {heroImage && <figure class="article-hero-image"><Image width={1200} height={600} src={heroImage} alt="" /></figure>}
          {current && <nav class="series-nav" aria-label="Experimentation in the Real World series">
            <strong>In this series</strong>
            <ol>{experimentSeries.map((item) => <li>
              {item.part === seriesPart ? <span aria-current="page"><small>Part {item.part}</small>{item.title}</span> : <a href={`/blog/${item.slug}/`}><small>Part {item.part}</small>{item.title}</a>}
            </li>)}</ol>
          </nav>}
          <div class="article-prose prose"><slot /></div>
          {current && <nav class="series-bottom" aria-label="Previous and next article">
            {previous ? <a href={`/blog/${previous.slug}/`}><small>← Previous · Part {previous.part}</small><strong>{previous.title}</strong></a> : <span />}
            {next ? <a href={`/blog/${next.slug}/`}><small>Next · Part {next.part} →</small><strong>{next.title}</strong></a> : <span />}
          </nav>}
        </article>
        {sections.length > 1 && <aside class="article-toc" aria-label="In this article">
          <strong>In this article</strong>
          <nav><ul>{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ul></nav>
        </aside>}
      </div>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .article-page { width: min(1120px, calc(100% - 64px)); margin: 0 auto; padding: 24px 0 32px; }
  .article-layout { display: grid; grid-template-columns: minmax(0, 760px) minmax(0, 220px); gap: 40px; justify-content: center; align-items: start; }
  .article-layout > article { min-width: 0; }
  .article-header { margin: 0 0 16px; padding-bottom: 16px; border-bottom: 1px solid var(--site-border); }
  .article-back { margin-bottom: 16px; font-size: 14px; }
  .article-header h1 { margin: 0 0 8px; font-size: clamp(34px, 3.3vw, 44px); line-height: 1.13; }
  .article-series-label { margin: 0 0 7px; color: var(--site-green); font-size: 12px; font-weight: 700; letter-spacing: .025em; }
  .article-header__description { margin: 0 0 8px; color: var(--site-muted); font-size: 17px; line-height: 1.5; }
  .article-header__meta { display: flex; flex-wrap: wrap; gap: 6px; color: var(--site-muted); font-size: 13px; }
  .article-hero-image { margin: 0 0 20px; }
  .article-hero-image img { display: block; width: 100%; height: auto; }
  .article-prose { min-width: 0; color: var(--site-text); }
  .article-prose > :first-child { margin-top: 0; }
  .article-prose p, .article-prose li { font-size: 17px; line-height: 1.6; }
  .article-prose p { margin: 0 0 13px; }
  .article-prose ul, .article-prose ol { margin: 0 0 14px; padding-left: 24px; }
  .article-prose li { margin-bottom: 4px; }
  .article-prose h2 { margin: 32px 0 12px; font-size: 26px; scroll-margin-top: 24px; }
  .article-prose h3 { margin: 24px 0 10px; font-size: 21px; scroll-margin-top: 24px; }
  .article-prose hr { margin: 24px 0; border-color: var(--site-border); }
  .article-prose blockquote { margin: 20px 0; padding: 4px 0 4px 16px; border-left: 3px solid var(--site-sage); color: var(--site-text); font-size: 17px; font-weight: 400; line-height: 1.6; }
  .article-prose blockquote p { margin-bottom: 0; }
  .article-prose pre { margin: 18px 0; padding: 16px; background: var(--site-code); color: var(--site-text); }
  .article-prose :not(pre) > code { padding: 2px 4px; background: var(--site-code); }
  .article-prose figure { margin: 20px 0 !important; }
  .article-prose img { display: block; max-width: 100%; height: auto; margin: 0; border: 1px solid var(--site-border); }
  .article-prose table { width: 100%; margin: 18px 0 20px; border-collapse: collapse; font-size: 15px; }
  .article-prose th, .article-prose td { padding: 8px 12px; border: 1px solid var(--site-border); text-align: left; }
  .article-prose thead { background: var(--site-code); }
  .article-prose :is(td, th):not(:first-child) { text-align: right; }
  .article--series .article-prose > table { width: 100%; table-layout: fixed; }
  .article--series .article-prose > table :is(th, td) { overflow-wrap: anywhere; hyphens: none; white-space: normal; }
  .article--series .article-prose > table td:not(:first-child) { font-variant-numeric: tabular-nums; }
  .article--series[data-series-part="2"] .article-prose > table:last-of-type :is(th, td):last-child,
  .article--series[data-series-part="3"] .article-prose > table:last-of-type :is(th, td):not(:first-child) { text-align: left; }
  .article--series[data-series-part="2"] .article-prose > table:first-of-type :is(th, td):first-child { width: 30%; }
  .article--series[data-series-part="3"] .article-prose > table:first-of-type :is(th, td):first-child { width: 27%; }
  .article--series[data-series-part="3"] .article-prose > table:first-of-type :is(th, td):nth-child(2) { width: 27%; }
  .article--series[data-series-part="3"] .article-prose > table:first-of-type :is(th, td):last-child { width: 46%; }
  .article--series[data-series-part="3"] .article-prose > table:last-of-type :is(th, td):first-child { width: 29%; }
  .article--series[data-series-part="3"] .article-prose > table:last-of-type :is(th, td):nth-child(2) { width: 29%; }
  .article--series[data-series-part="3"] .article-prose > table:last-of-type :is(th, td):last-child { width: 42%; }
  .article--series .article-prose .katex-display { max-width: 100%; margin: 14px 0 16px; overflow-x: auto; overflow-y: hidden; text-align: center; font-size: 1.3em; }
  .article--series .article-prose .katex-display > .katex { display: inline-block; text-align: left; }
  .article--series .article-prose p > .katex { font-size: 1em; }
  .series-nav { margin: 0 0 20px; padding: 12px 0 14px; border-bottom: 1px solid var(--site-border); }
  .series-nav > strong { display: block; margin-bottom: 7px; color: var(--site-muted); font-size: 12px; }
  .series-nav ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .series-nav li { min-width: 0; }
  .series-nav a, .series-nav li > span { display: block; height: 100%; padding: 8px 9px; border-left: 2px solid var(--site-border); color: var(--site-muted); font-size: 12px; line-height: 1.3; text-decoration: none; }
  .series-nav li > span[aria-current] { border-left-color: var(--site-green); color: var(--site-text); font-weight: 700; }
  .series-nav a:hover, .series-nav a:focus-visible { border-left-color: var(--site-green); color: var(--site-green); }
  .series-nav small { display: block; margin-bottom: 3px; color: var(--site-green); font-size: 10px; font-weight: 700; text-transform: uppercase; }
  .series-bottom { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 28px 0 4px; padding-top: 16px; border-top: 1px solid var(--site-border); }
  .series-bottom a { display: block; color: var(--site-green); line-height: 1.35; text-decoration: none; }
  .series-bottom a:last-child { text-align: right; }
  .series-bottom a:hover strong { text-decoration: underline; }
  .series-bottom small { display: block; margin-bottom: 3px; color: var(--site-muted); font-size: 11px; }
  .series-bottom strong { font-size: 13px; }
  .article-toc { position: sticky; top: 24px; margin-top: 80px; padding-left: 20px; border-left: 1px solid var(--site-border); font-size: 13px; }
  .article-toc strong { display: block; margin: 0 0 12px; color: var(--site-text); font-size: 14px; }
  .article-toc ul { margin: 0; padding: 0; list-style: none; }
  .article-toc li { margin: 0 0 8px; }
  .article-toc a { color: var(--site-muted); text-decoration: none; }
  .article-toc a:hover, .article-toc a:focus-visible { color: var(--site-green); text-decoration: underline; }
  @media (max-width: 900px) { .article-layout { grid-template-columns: minmax(0, 760px); } .article-toc { display: none; } }
  @media (max-width: 720px) { .article-page { width: min(1120px, calc(100% - 40px)); padding-top: 24px; } .article-header h1 { font-size: 32px; } .article-header__description { font-size: 16px; } .article-prose p, .article-prose li { font-size: 16px; } .article-prose table { display: block; overflow-x: auto; white-space: nowrap; } .article--series .article-prose > table { display: table; overflow: visible; font-size: 14px; } .article--series .article-prose > table :is(th, td) { padding: 5px 6px; line-height: 1.35; } .article--series .article-prose .katex-display { font-size: 1.3em; } .series-nav ol { grid-template-columns: 1fr; gap: 2px; } .series-nav a, .series-nav li > span { padding: 5px 9px; } }
</style>
